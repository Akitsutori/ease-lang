{
  "name": "ease-lang",
  "displayName": "Ease Language",
  "description": "Syntax highlighting, live diagnostics, outline symbols, autocomplete, and direct run/test support for Ease (.ease)",
  "version": "0.1.3",
  "publisher": "ease-lang",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Programming Languages",
    "Debuggers"
  ],
  "activationEvents": [
    "onLanguage:ease",
    "onDebugInitialConfigurations",
    "onDebugResolve:ease"
  ],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "command": "ease.runFile",
        "title": "Ease: Run File",
        "icon": "$(play)"
      },
      {
        "command": "ease.testFile",
        "title": "Ease: Run Tests",
        "icon": "$(beaker)"
      }
    ],
    "menus": {
      "editor/title/run": [
        {
          "command": "ease.runFile",
          "when": "resourceExtname == .ease",
          "group": "navigation@1"
        },
        {
          "command": "ease.testFile",
          "when": "resourceExtname == .ease",
          "group": "navigation@2"
        }
      ]
    },
    "debuggers": [
      {
        "type": "ease",
        "label": "Ease",
        "languages": [
          "ease"
        ],
        "configurationAttributes": {
          "launch": {
            "required": [
              "program"
            ],
            "properties": {
              "program": {
                "type": "string",
                "description": "Path to the .ease file to run",
                "default": "${file}"
              }
            }
          }
        },
        "initialConfigurations": [
          {
            "type": "ease",
            "request": "launch",
            "name": "Run Ease File",
            "program": "${file}"
          }
        ]
      }
    ],
    "languages": [
      {
        "id": "ease",
        "aliases": [
          "Ease",
          "ease"
        ],
        "extensions": [
          ".ease"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "ease",
        "scopeName": "source.ease",
        "path": "./syntaxes/ease.tmLanguage.json"
      }
    ],
    "configuration": {
      "title": "Ease",
      "properties": {
        "ease.executablePath": {
          "type": "string",
          "default": "ease",
          "description": "Path to the ease CLI executable (used to launch `ease lsp`)."
        }
      }
    }
  }
}
