# Feature 07: Homogene Listen (list), Punkt-Indexierung, Schleifen & if/else

def particle
    x = 0
    vx = 10
    life = 100
    state = "active" | "dead"
end

to sum_squares xs
    total = 0
    loop xs
        total = total + (it * it)
    end
    -> total
end

to count_down start
    out = list as number
    cur = start
    loop range 1 start
        out = append out cur
        cur = cur - 1
    end
    -> out
end

to classify n
    check n > 0 -> "positiv"
    -> "nicht-positiv"
end

test "Listen, Schleifen & Verzweigungen"
    scores = list 10, 25, 40
    scores.1 is 10
    count scores is 3
    (slice scores 1 2) is list 10, 25

    updated_scores = scores with .2 = 99
    updated_scores is list 10, 99, 40
    scores.2 is 25

    empty_nums = list as number
    empty_nums is list
    count empty_nums is 0

    cloud = list as particle with
        x = 0, vx = 5, life = 20
        x = 10, vx = 2, life = 5
    end
    count cloud is 2
    cloud.1.vx is 5
    cloud.2.state is "active"

    sum_x = 0
    loop cloud
        sum_x = sum_x + it.x
    end
    sum_x is 10

    vx = 100
    seen_outer = 0
    seen_vx = 0
    loop cloud
        vx is 100
        seen_outer = vx
        seen_vx = seen_vx + it.vx
    end
    seen_outer is 100
    seen_vx is 7

    nums = range 1 4
    sum_squares nums is 30
    count_down 3 is list 3, 2, 1
    classify 5 is "positiv"
    classify 0 is "nicht-positiv"

    moved = update cloud with x = it.x + it.vx
    moved.1.x is 5
    moved.2.x is 12

    active_moved = update cloud where it.vx >= 5 with life = it.life - 5
    active_moved.1.life is 15
    active_moved.2.life is 5

    fast = cloud where it.vx >= 5
    count fast is 1
    fast.1.vx is 5
end
