def job
    id = 0
    value = 0
end

to double_all nums as list of number
    -> swarm loop nums -> it * 2 end
end

to worker jobs out
    take jobs
        check it.value < 0
            close out
            -> return
        end
        check it.value is 0
            -> stop
        end
        put out (it with value = it.value * 10)
    end
    close out
end

to run_pipeline items as list of job
    jobs = inbox as job
    out = inbox as job
    spawn worker jobs out
    swarm loop items
        put jobs it
        -> 0
    end
    close jobs
    res = list as job
    take out
        res = append res it
    end
    -> res
end
