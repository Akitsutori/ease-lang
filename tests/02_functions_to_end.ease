# Feature 02: Funktionen (to ... end), implizite Rückgabe & klammerfreie Aufrufe

to add a b
    a + b
end

to safe_div a b
    check b is 0 -> fail "Division durch Null"
    a / b
end

test
    add 2 3 is 5
    add 10 -4 is 6
    safe_div 10 2 is 5
    safe_div 9 3 is 3
    safe_div 1 0 is error
end
