# Feature 04: Union Types (explizite Werteräume statt Boolean)
# Warum kein bool / true / false?
# Anonyme Wahrheitswerte verbergen am Aufrufort, WAS und WARUM entschieden wurde.
# Mit benannten Union-Werten trägt jedes Ergebnis seine Fachbedeutung direkt im Wert.

def ticket = "vip" | "standard" | "none"
def door_state = "open" | "locked"

def ErrorMessage
    code    = 500
    message = "Unknown error"
end

def status = "OK" | "FEHLER"
def outcome = status | ErrorMessage
def id_or_name = number | text

def entry_gate
    door = "open" | "locked"
end

to evaluate_entry pass door
    check pass is not ticket     -> "Ungültiger Ticket-Typ"
    check door is not door_state -> "Unbekannter Türzustand"
    check door is "locked"       -> "Tür ist verschlossen"
    check pass is "none"         -> "Kein Einlass ohne Ticket"
    check pass is "vip"          -> "VIP-Lounge geöffnet"
    -> "Standard-Einlass gewährt"
end

to process_response res
    check res is "OK"         -> "Erfolgreich verarbeitet"
    check res is "FEHLER"     -> "Unbekannter Fehler"
    check res is ErrorMessage -> "Fehler {res.code}: {res.message}"
end

to log_only_success res
    check res is "OK" -> "Hat geklappt"
    -> "Irgendetwas anderes ist passiert"
end

test "Union Types & Werteraum-Prüfung"
    "vip" is ticket
    "gold" is not ticket
    "open" is door_state
    "OK" is outcome
    42 is id_or_name
    "Ada" is id_or_name

    err = ErrorMessage with code = 503, message = "Service unavailable"
    err is outcome
    process_response "OK" is "Erfolgreich verarbeitet"
    process_response "FEHLER" is "Unbekannter Fehler"
    process_response err is "Fehler 503: Service unavailable"
    log_only_success "OK" is "Hat geklappt"
    log_only_success "FEHLER" is "Irgendetwas anderes ist passiert"
    log_only_success err is "Irgendetwas anderes ist passiert"

    parsed_json = '{"code": 404, "message": "Not Found"}' as json
    parsed = parsed_json as outcome
    parsed is ErrorMessage
    process_response parsed is "Fehler 404: Not Found"

    evaluate_entry "vip" "open" is "VIP-Lounge geöffnet"
    evaluate_entry "standard" "open" is "Standard-Einlass gewährt"
    evaluate_entry "none" "open" is "Kein Einlass ohne Ticket"
    evaluate_entry "vip" "locked" is "Tür ist verschlossen"
    evaluate_entry "gold" "open" is "Ungültiger Ticket-Typ"
    evaluate_entry "vip" "broken" is "Unbekannter Türzustand"
    (entry_gate with door = "true") is error
    (entry_gate with door = "ajar") is error
end
