# Feature 08: Denken ohne Booleans & die sprachliche Rollenverteilung (def / to / ->)
#
# 1. Warum Ease auf `bool` (`true`/`false`) verzichtet:
#    - Bedingungen wie `amount >= 50` bleiben direkt im Kontrollfluss (`check`, `where`, `test`).
#    - Auch versteckte Ersatz-Booleans wie `"yes" | "no"` oder Passiv-Flags wie `taken = "yes" | "no"`
#      sind „Boolean Pollution“: stattdessen benennt man immer den echten Zustand des Dings selbst
#      (z. B. `"free" | "occupied"`, `"ready" | "held"`, `"ship" | "below_minimum" | "manual_review"`).
#
# 2. Warum `to` als grammatikalisches Geländer wirkt:
#    - Neutrale Keywords wie `def` (Python) oder `func` (Go) verleiten zu `def user_data()`
#      oder `def can_ship()` (Frage ohne klare Handlung).
#    - In Ease klingt `to user_data` ("zu Nutzerdaten") oder `to can_ship` ("zu können verschicken")
#      beim lauten Lesen sofort falsch und lenkt automatisch auf ein echtes Handlungsverb:
#        def = Substantiv (passiver Bauplan:  def shipment)
#        to  = Infinitiv  (Absicht/Fähigkeit:  to prepare_shipment amount)
#         = Imperativ  (konkrete Ausführung: prepare_shipment 80)

# --- Schritt 1: Echter Ding-Zustand statt anonymem Boolean oder "yes"/"no"-Flag ---

def shipment
    state = "ready" | "held"
end

# Statt `to can_ship amount` (-> klingt falsch!) zwingt `to` zu einer klaren Handlung:
to prepare_shipment amount
    check amount >= 50 -> shipment with state = "ready"
    -> shipment with state = "held"
end

test "Rollenverteilung def (Substantiv) / to (Infinitiv) / (Imperativ)"
    s1 = prepare_shipment 80
    s1.state is "ready"

    s2 = prepare_shipment 20
    s2.state is "held"

    # Anders als freier Text prüft `def shipment` den Wertebereich strikt:
    (shipment with state = "maybe") is error
    (shipment with state = "true") is error
end

# --- Schritt 2: Von Ja/Nein nahtlos zu sprechenden Fachzuständen ---
# Sobald eine Entscheidung mehr als zwei Gründe hat, bricht `bool` zusammen.
# In Ease erweitert man einfach den Wertebereich ohne Schnittstellenbruch:

def shipping_plan
    status = "ship" | "below_minimum" | "manual_review"
    reason = "ok"
end

to plan_shipment amount risk_level
    check
        risk_level is "high" -> shipping_plan with status = "manual_review", reason = "high risk"
        amount < 50          -> shipping_plan with status = "below_minimum", reason = "minimum 50"
    end
    -> shipping_plan with status = "ship", reason = "ready"
end

test "Ohne Booleans: sprechende Zustände statt kryptischer Flags"
    p1 = plan_shipment 80 "low"
    p1.status is "ship"
    p1.reason is "ready"

    p2 = plan_shipment 20 "low"
    p2.status is "below_minimum"
    p2.reason is "minimum 50"

    p3 = plan_shipment 120 "high"
    p3.status is "manual_review"
    p3.reason is "high risk"

    (shipping_plan with status = "cancelled") is error
end
