# Feature 08: Denken ohne Booleans & die sprachliche Rollenverteilung (def / to / do)
#
# 1. Warum Ease auf `bool` (`true`/`false`) verzichtet:
#    - Bedingungen wie `amount >= 50` bleiben direkt im Kontrollfluss (`check`, `if`, `test`).
#    - Ergebnisse und Zustände nutzen explizite `def`-Unions (`"yes" | "no"`, `"ship" | "hold"`),
#      statt anonyme Booleans zurückzugeben ("Boolean Blindness" am Aufrufort verschwindet).
#
# 2. Warum `to` als grammatikalisches Geländer wirkt:
#    - Neutrale Keywords wie `def` (Python) oder `func` (Go) verleiten zu `def user_data()`
#      oder `def can_ship()` (Frage ohne klare Handlung).
#    - In Ease klingt `to user_data` ("zu Nutzerdaten") oder `to can_ship` ("zu können verschicken")
#      beim lauten Lesen sofort falsch und lenkt automatisch auf ein echtes Handlungsverb:
#        def = Substantiv (passiver Bauplan:  def decision)
#        to  = Infinitiv  (Absicht/Fähigkeit:  to decide_if_to_ship amount)
#        do  = Imperativ  (konkrete Ausführung: do decide_if_to_ship 80)

# --- Schritt 1: Explizite Ja/Nein-Entscheidung statt anonymem Boolean ---

def decision
    answer = "yes" | "no"
end

# Statt `to can_ship amount` (-> klingt falsch!) zwingt `to` zu einer klaren Handlung:
to decide_if_to_ship amount
    check amount >= 50 -> decision with answer = "yes"
    decision with answer = "no"
end

test "Rollenverteilung def (Substantiv) / to (Infinitiv) / do (Imperativ)"
    d1 = do decide_if_to_ship 80
    d1.answer is "yes"

    d2 = do decide_if_to_ship 20
    d2.answer is "no"

    # Anders als freier Text prüft `def decision` den Wertebereich strikt:
    (decision with answer = "maybe") raises "Invalid value"
    (decision with answer = "true")  raises "Invalid value"
end

# --- Schritt 2: Von Ja/Nein nahtlos zu sprechenden Fachzuständen ---
# Sobald eine Entscheidung mehr als zwei Gründe hat, bricht `bool` zusammen.
# In Ease erweitert man einfach den Wertebereich ohne Schnittstellenbruch:

def shipping_plan
    status = "ship" | "below_minimum" | "manual_review"
    reason = "ok"
end

to plan_shipment amount risk_level
    check
        risk_level is "high" -> shipping_plan with status = "manual_review", reason = "high risk"
        amount < 50          -> shipping_plan with status = "below_minimum", reason = "minimum 50"
    end
    shipping_plan with status = "ship", reason = "ready"
end

test "Ohne Booleans: sprechende Zustände statt kryptischer Flags"
    p1 = do plan_shipment 80 "low"
    p1.status is "ship"
    p1.reason is "ready"

    p2 = do plan_shipment 20 "low"
    p2.status is "below_minimum"
    p2.reason is "minimum 50"

    p3 = do plan_shipment 120 "high"
    p3.status is "manual_review"
    p3.reason is "high risk"

    (shipping_plan with status = "cancelled") raises "Invalid value"
end
