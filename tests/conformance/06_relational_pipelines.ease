# wasm-parity
# Conformance 06: where (inline & block), update, sort by, loop ->, any/none quantifiers

def prio_kind = "urgent" | "normal" | "low"

def task
    id = 0
    prio = prio_kind
    pts = 0
end

def badge
    label = ""
end

to make_badge t as badge
    -> badge with label = "{t.id}:{t.prio}"
end

tasks = list as task with
    id = 3, prio = "low", pts = 10
    id = 1, prio = "urgent", pts = 30
    id = 2, prio = "urgent", pts = 50
    id = 4, prio = "normal", pts = 20
end

multi_filtered = tasks where
    it.pts >= 20
    it.prio is not "normal"
end

boosted = update tasks where it.prio is "low" with pts = it.pts + 15
ordered = sort boosted by it.prio, -it.pts, it.id

doubled = loop range 1 3 -> it * 2
badges = loop ordered -> make_badge it
boxes = loop ordered where it.pts >= 25 -> badge with
    label = "#{it.index}:{it.id}"
end
empty_proj = loop (list as task) -> it.id

div_pair = list 2, 0
short_circuit_ok = "no"
check any div_pair where (10 / it) is 5 and none tasks where it.pts < 0
    short_circuit_ok = "yes"
end

test "relational pipelines: where, update, sort by, loop ->, any/none"
    count multi_filtered is 2
    ordered.1.id is 2
    ordered.2.id is 1
    ordered.3.id is 4
    ordered.4.id is 3
    ordered.4.pts is 25
    doubled is list 2, 4, 6
    badges.1.label is "2:urgent"
    count boxes is 3
    boxes.1.label is "#1:2"
    count empty_proj is 0
    short_circuit_ok is "yes"
    any tasks where it.prio is "low"
    none tasks where it.pts > 100
end

say "{ordered.1.id}|{ordered.4.pts}|{badges.1.label}|{boxes.1.label}|{short_circuit_ok}"
