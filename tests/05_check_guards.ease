# Feature 05: Check-Guards (Einzeiler ->, Effekt-Block & Verdict-Tabelle)

to validate_score name score
    check
        name is not text -> "Name muss Text sein"
        name is ""       -> "Name fehlt"
        score is not number -> "Punktzahl muss Zahl sein"
        score < 0           -> "Punktzahl darf nicht negativ sein"
    end
    -> "OK: {name} hat {score} Punkte"
end

to review_article title words
    check
        title is not text   -> "rejected"
        title is ""         -> "rejected"
        words is not number -> "rejected"
        words < 100         -> "rejected"
        else                -> "published"
    end
end

status_msg = "init"
check status_msg is text
    status_msg = "checked"
end

test "Check-Guards"
    validate_score 42 10 is "Name muss Text sein"
    validate_score "" 10 is "Name fehlt"
    validate_score "Ada" "ten" is "Punktzahl muss Zahl sein"
    validate_score "Ada" -5 is "Punktzahl darf nicht negativ sein"
    validate_score "Ada" 99 is "OK: Ada hat 99 Punkte"
    review_article "Guide" 150 is "published"
    review_article "" 150 is "rejected"
    review_article "Guide" 20 is "rejected"
    status_msg is "checked"
end
