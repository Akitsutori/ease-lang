import network

# Concurrent HTTP server built on the explicit `inbox` idiom.
# `network:serve_http` pushes each incoming HTTP request into `requests`;
# `spawn` handles each request concurrently and `close requests` shuts down the listener.

def server_status
    service = "ease-http"
    status  = "healthy"
    layer   = 7
end

to handle_http req
    match "{req.method} {req.path}"
        "GET /"
            network:reply_text req 200 "Welcome to Ease HTTP!"
        "GET /health"
            network:reply_json req 200 (server_status)
        "GET /hello/{name}"
            network:reply_text req 200 "Hello, {name}!"
        else
            network:reply_text req 404 "Not Found"
    end
end

to serve_loop requests
    take requests
        spawn handle_http it
    end
end

test "concurrent HTTP routes respond cleanly via inbox on ephemeral port"
    requests = inbox as network.http_request
    port = network:serve_http 0 requests
    port > 0
    spawn serve_loop requests

    client = network.network with url = "http://127.0.0.1:{port}"
    routes = list "/", "/health", "/hello/Ada", "/unknown"
    replies = swarm loop routes
        -> network:fetch client it
    end

    replies.1 is "Welcome to Ease HTTP!"
    replies.2 is (server_status as json)
    replies.3 is "Hello, Ada!"
    replies.4 is ""

    close requests
end

to start_server port
    requests = inbox as network.http_request
    bound_port = network:serve_http port requests
    check bound_port is 0
        close requests
        -> 0
    end
    say "HTTP server listening on http://127.0.0.1:{bound_port}"
    serve_loop requests
    -> bound_port
end

start_server 8080
