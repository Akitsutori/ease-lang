import screen
import random
import synth

# Arcade Tetris in pure Ease — native desktop & browser WASM.
def piece_spec
    kind   = "I" | "O" | "T"
    color  = "#06b6d4"
    cx     = 5
    cy     = 2
    coords = list as number
end
def block
    col   = 0
    row   = 0
    color = "#06b6d4"
    state = "falling" | "locked"
end
def tetris_world
    blocks    = list as block
    prev_keys = list as text
    spec      = piece_spec
    next_spec = piece_spec
    cx        = 5
    cy        = 2
    score     = 0
    lines     = 0
    level     = 1
    grav_cd   = 0
    move_cd   = 0
    status    = "playing" | "paused" | "over"
    audio     = "on" | "muted"
end

to piece_catalog
    -> list as piece_spec with
        kind = "I", color = "#06b6d4", cx = 5.5, cy = 1.5, coords = (list 4, 1, 5, 1, 6, 1, 7, 1)
        kind = "O", color = "#eab308", cx = 5.5, cy = 1.5, coords = (list 5, 1, 6, 1, 5, 2, 6, 2)
        kind = "T", color = "#a855f7", cx = 5,   cy = 2,   coords = (list 5, 1, 4, 2, 5, 2, 6, 2)
        kind = "T", color = "#22c55e", cx = 5,   cy = 2,   coords = (list 5, 1, 6, 1, 4, 2, 5, 2)
        kind = "T", color = "#ef4444", cx = 5,   cy = 2,   coords = (list 4, 1, 5, 1, 5, 2, 6, 2)
        kind = "T", color = "#3b82f6", cx = 5,   cy = 2,   coords = (list 4, 1, 4, 2, 5, 2, 6, 2)
        kind = "T", color = "#f97316", cx = 5,   cy = 2,   coords = (list 6, 1, 4, 2, 5, 2, 6, 2)
    end
end
to spawn_blocks sp
    c = sp.coords
    out = list as block
    loop list 1, 3, 5, 7
        out = append out (block with col = c.(it), row = c.(it + 1), color = sp.color, state = "falling")
    end
    -> out
end
to key_hit keys prev k
    check contains keys k and not (contains prev k) -> "hit"
    -> "none"
end
to toggle v a b
    check v is a -> b
    -> a
end
to valid_pos cand locked
    loop cand
        c = it.col
        r = it.row
        check c < 1 or c > 10 or r < -1 or r > 20 or (count (locked where it.col is c and it.row is r)) > 0 -> "blocked"
    end
    -> "valid"
end
to ghost_blocks w
    cur = w.blocks where it.state is "falling"
    locked = w.blocks where it.state is "locked"
    loop range 1 22
        nxt = update cur with row = it.row + 1
        check (valid_pos nxt locked) is "blocked" -> end
        cur = nxt
    end
    -> cur
end
to clear_full_lines locked
    cur = locked
    loop range 1 20
        r = it
        check (count (cur where it.state is "locked" and it.row is r)) is 10
            cur = update (cur where it.row is not r) where it.state is "locked" and it.row < r with row = it.row + 1
        end
    end
    -> cur
end
to init_world cat audio
    s1 = random:pick cat
    s2 = random:pick cat
    -> tetris_world with blocks = spawn_blocks s1, prev_keys = list as text, spec = s1, next_spec = s2, cx = s1.cx, cy = s1.cy, audio = audio
end
to sys_toggles w keys cat bgm
    cur = w
    check (key_hit keys w.prev_keys "p") is "hit" and cur.status is not "over"
        cur = cur with status = toggle cur.status "playing" "paused"
    end
    check (key_hit keys w.prev_keys "m") is "hit"
        cur = cur with audio = toggle cur.audio "on" "muted"
    end
    check (key_hit keys w.prev_keys "r") is "hit"
        cur = init_world cat cur.audio
    end
    check cur.status is not w.status or cur.audio is not w.audio or (key_hit keys w.prev_keys "r") is "hit"
        check cur.status is "playing" and cur.audio is "on"
            synth:play bgm
        else
            synth:stop
        end
    end
    -> cur
end
to sys_input w keys sfx_rot
    check w.status is not "playing" -> w
    cur = w
    dx = 0
    check contains keys "left" or contains keys "a"
        dx = -1
    end
    check contains keys "right" or contains keys "d"
        dx = 1
    end
    falling = cur.blocks where it.state is "falling"
    locked = cur.blocks where it.state is "locked"
    check dx is 0
        cur = cur with move_cd = 0
    else
        check cur.move_cd is 0 and (valid_pos (update falling with col = it.col + dx) locked) is "valid"
            falling = update falling with col = it.col + dx
            cur = cur with blocks = (append locked falling), cx = cur.cx + dx, move_cd = 7
        else
            cur = cur with move_cd = max 0 (cur.move_cd - 1)
        end
    end
    check cur.spec.kind is "O" or ((key_hit keys cur.prev_keys "up") is "none" and (key_hit keys cur.prev_keys "w") is "none") -> cur
    rot = update falling with col = cur.cx - (it.row - cur.cy), row = cur.cy + (it.col - cur.cx)
    loop list 0, -1, 1, -2, 2
        dx_k = it
        cand = update rot with col = it.col + dx_k
        check (valid_pos cand locked) is "valid"
            check cur.audio is "on"
                spawn synth:play sfx_rot
            end
            -> cur with blocks = (append locked cand), cx = cur.cx + dx_k
        end
    end
    -> cur
end
to sys_physics w keys tick cat sfx_lock sfx_line sfx_tet sfx_over
    check w.status is not "playing" -> w
    falling = w.blocks where it.state is "falling"
    locked = w.blocks where it.state is "locked"
    bonus = 0
    check (key_hit keys w.prev_keys "space") is "hit"
        dropped = ghost_blocks w
        bonus = (dropped.1.row - falling.1.row) * 2
        falling = dropped
    else
        soft = 0
        check (contains keys "down" or contains keys "s") and (tick % 2) is 0
            soft = 1
        else
            check (w.grav_cd + 1) < (max 6 (48 - ((w.level - 1) * 4))) -> w with grav_cd = w.grav_cd + 1
        end
        check (valid_pos (update falling with row = it.row + 1) locked) is "valid" -> w with blocks = (append locked (update falling with row = it.row + 1)), cy = w.cy + 1, score = w.score + soft, grav_cd = 0
    end
    flipped = append locked (update falling with state = "locked")
    after = clear_full_lines flipped
    cleared = floor (((count flipped) - (count after)) / 10)
    nl = w.lines + cleared
    pts = bonus + ((list 0, 100, 300, 500, 800).(cleared + 1) * w.level)
    check w.audio is "on"
        spawn synth:play ((list sfx_lock, sfx_line, sfx_line, sfx_line, sfx_tet).(cleared + 1))
    end
    nxt = spawn_blocks w.next_spec
    lvl = 1 + (floor (nl / 10))
    check (valid_pos nxt after) is "blocked"
        synth:stop
        check w.audio is "on"
            spawn synth:play sfx_over
        end
        -> w with blocks = (append after nxt), score = w.score + pts, lines = nl, level = lvl, status = "over"
    end
    -> w with blocks = (append after nxt), spec = w.next_spec, next_spec = random:pick cat, cx = w.next_spec.cx, cy = w.next_spec.cy, score = w.score + pts, lines = nl, level = lvl, grav_cd = 0
end
to draw_game win w
    screen:clear win "#0f172a"
    screen:draw win (list as screen.box with
        x = 24, y = 52, width = 280, height = 560, color = "#020617"
        x = 332, y = 52, width = 164, height = 132, color = "#1e293b"
        x = 332, y = 52, width = 164, height = 132, color = "#334155", style = "outline", stroke = 2
        x = 332, y = 200, width = 164, height = 176, color = "#1e293b"
        x = 332, y = 200, width = 164, height = 176, color = "#334155", style = "outline", stroke = 2
        x = 22, y = 50, width = 284, height = 564, color = "#334155", style = "outline", stroke = 2
    end)
    loop range 1 19
        screen:draw win (screen.line with x1 = 24, y1 = 52 + (it * 28), x2 = 304, y2 = 52 + (it * 28), width = 1, color = "#1e293b")
        check it <= 9
            screen:draw win (screen.line with x1 = 24 + (it * 28), y1 = 52, x2 = 24 + (it * 28), y2 = 612, width = 1, color = "#1e293b")
        end
    end
    check w.status is "playing"
        loop ghost_blocks w
            check it.row >= 1
                screen:draw win (screen.box with x = 24 + ((it.col - 1) * 28) + 2, y = 52 + ((it.row - 1) * 28) + 2, width = 24, height = 24, color = it.color, style = "outline", stroke = 2)
            end
        end
    end
    loop w.blocks
        check it.row >= 1
            screen:draw win (screen.box with x = 24 + ((it.col - 1) * 28) + 1, y = 52 + ((it.row - 1) * 28) + 1, width = 26, height = 26, color = it.color)
        end
    end
    loop spawn_blocks w.next_spec
        screen:draw win (screen.box with x = 372 + ((it.col - 4) * 22), y = 98 + ((it.row - 1) * 22), width = 20, height = 20, color = it.color)
    end
    screen:draw win (list as screen.label with
        x = 24, y = 16, content = "EASE TETRIS   60 FPS", size = 22, color = "#06b6d4"
        x = 346, y = 64, content = "NEXT", size = 16, color = "#cbd5e1"
        x = 346, y = 218, content = "SCORE  {w.score}", size = 18, color = "#facc15"
        x = 346, y = 264, content = "LVL {w.level}   LINES {w.lines}", size = 16, color = "#10b981"
        x = 332, y = 404, content = "Move: L/R   Rot: Up/W", size = 13, color = "#94a3b8"
        x = 332, y = 428, content = "Drop: Dn/Space   Pause: P", size = 13, color = "#94a3b8"
        x = 332, y = 452, content = "Audio({w.audio}): M  Reset: R  Esc", size = 13, color = "#94a3b8"
    end)
    check w.status is not "playing"
        clr = "#eab308"
        msg = "PAUSED - Press P"
        check w.status is "over"
            clr = "#ef4444"
            msg = "GAME OVER - Press R"
        end
        screen:draw win (screen.box with x = 36, y = 260, width = 256, height = 84, color = "#020617")
        screen:draw win (screen.box with x = 36, y = 260, width = 256, height = 84, color = clr, style = "outline", stroke = 3)
        screen:draw win (screen.label with x = 56, y = 290, content = msg, size = 18, color = clr)
    end
end
to run_tetris
    win = screen.screen with width = 520, height = 660, title = "Ease Tetris", fps = 60
    part_a = "E5/4 B4/8 C5/8 D5/4 C5/8 B4/8 A4/4 A4/8 C5/8 E5/4 D5/8 C5/8 B4/4 B4/8 C5/8 D5/4 E5/4 C5/4 A4/4 A4/2 REST/8 D5/4 F5/8 A5/4 G5/8 F5/8 E5/4 REST/8 C5/8 E5/4 D5/8 C5/8 B4/4 B4/8 C5/8 D5/4 E5/4 C5/4 A4/4 A4/2"
    bgm = synth.melody with notes = split "{part_a} {part_a} E4/2 C4/2 D4/2 B3/2 C4/2 A3/2 G#3/2 B3/4 REST/4 E4/2 C4/2 D4/2 B3/2 C4/4 E4/4 A4/2 G#4/2 REST/2" " ", bpm = 148, wave = "square", volume = 18, repeat = "forever"
    sfx_rot = synth.melody with notes = (list "E5/32"), bpm = 240, wave = "triangle", volume = 45
    sfx_lock = synth.melody with notes = (list "G3/32"), bpm = 240, wave = "triangle", volume = 60
    sfx_line = synth.melody with notes = (list "C5/16", "E5/16", "G5/16"), bpm = 200, wave = "triangle", volume = 65
    sfx_tet = synth.melody with notes = (list "C5/16", "E5/16", "G5/16", "C6/8"), bpm = 200, wave = "triangle", volume = 70
    sfx_over = synth.melody with notes = (list "G4/8", "E4/8", "C4/4"), bpm = 160, wave = "triangle", volume = 65
    cat = piece_catalog
    w = init_world cat "on"
    synth:play bgm
    loop
        draw_game win w
        frame = screen:show win
        check frame.status is "closed" or contains frame.keys "escape" -> end
        keys = frame.keys
        w = sys_toggles w keys cat bgm
        w = sys_input w keys sfx_rot
        w = sys_physics w keys it.index cat sfx_lock sfx_line sfx_tet sfx_over
        w = w with prev_keys = keys
    end
    synth:stop
end
test "tetris ECS systems: rotation wall-kick and multi-line clear"
    cat = piece_catalog
    t = cat.3
    w = sys_input (tetris_world with blocks = (update (spawn_blocks t) with col = it.col - 3, row = it.row + 2), spec = t, next_spec = t, cx = 2, cy = 4, audio = "muted") (list "up") (synth.melody with notes = (list "E5/32"), bpm = 240, wave = "triangle", volume = 45)
    count (w.blocks where it.state is "falling") is 4
    w.cx >= 2
    board = list as block
    loop range 1 10
        board = append board (list (block with col = it, row = 19, color = "#06b6d4", state = "locked"), (block with col = it, row = 20, color = "#eab308", state = "locked"))
    end
    after = clear_full_lines (append board (block with col = 5, row = 18, color = "#a855f7", state = "locked"))
    count after is 1
    after.1.col is 5
    after.1.row is 20
    count (ghost_blocks (w with blocks = (append after (w.blocks where it.state is "falling")))) is 4
end
