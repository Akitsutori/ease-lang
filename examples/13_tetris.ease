import screen
import random
import synth

# Arcade Tetris in pure Ease — native desktop & browser WASM.
def piece_kind = "I" | "O" | "T" | "S" | "Z" | "J" | "L"
def pos_status = "valid" | "blocked"
def hit_state = "hit" | "none"
def game_status = "playing" | "paused" | "over"
def audio_mode = "on" | "muted"
def player_action = "none" | "left" | "right" | "rotate" | "soft_drop" | "drop" | "pause" | "mute" | "restart"
def sound_event = "none" | "rotated" | "locked" | "line" | "tetris" | "over"

def piece_spec
    kind   = piece_kind
    color  = "#06b6d4"
    cx     = 5
    cy     = 2
    coords = list as number
end

def block
    col   = 0
    row   = 0
    color = "#06b6d4"
end

def tetris_world
    active     = list as block
    board      = list as block
    spec       = piece_spec
    next_spec  = piece_spec
    cx         = 5
    cy         = 2
    score      = 0
    lines      = 0
    level      = 1
    grav_cd    = 0
    move_cd    = 0
    status     = game_status
    audio      = audio_mode
    last_event = sound_event
end

def piece_catalog = list as piece_spec with
    kind = "I", color = "#06b6d4", cx = 5.5, cy = 1.5, coords = (list 4, 1, 5, 1, 6, 1, 7, 1)
    kind = "O", color = "#eab308", cx = 5.5, cy = 1.5, coords = (list 5, 1, 6, 1, 5, 2, 6, 2)
    kind = "T", color = "#a855f7", cx = 5,   cy = 2,   coords = (list 5, 1, 4, 2, 5, 2, 6, 2)
    kind = "S", color = "#22c55e", cx = 5,   cy = 2,   coords = (list 5, 1, 6, 1, 4, 2, 5, 2)
    kind = "Z", color = "#ef4444", cx = 5,   cy = 2,   coords = (list 4, 1, 5, 1, 5, 2, 6, 2)
    kind = "J", color = "#3b82f6", cx = 5,   cy = 2,   coords = (list 4, 1, 4, 2, 5, 2, 6, 2)
    kind = "L", color = "#f97316", cx = 5,   cy = 2,   coords = (list 6, 1, 4, 2, 5, 2, 6, 2)
end

def korobeiniki_part_a = "E5/4 B4/8 C5/8 D5/4 C5/8 B4/8 A4/4 A4/8 C5/8 E5/4 D5/8 C5/8 B4/4 B4/8 C5/8 D5/4 E5/4 C5/4 A4/4 A4/2 REST/8 D5/4 F5/8 A5/4 G5/8 F5/8 E5/4 REST/8 C5/8 E5/4 D5/8 C5/8 B4/4 B4/8 C5/8 D5/4 E5/4 C5/4 A4/4 A4/2"
def korobeiniki_bgm = synth.melody with notes = split "{korobeiniki_part_a} {korobeiniki_part_a} E4/2 C4/2 D4/2 B3/2 C4/2 A3/2 G#3/2 B3/4 REST/4 E4/2 C4/2 D4/2 B3/2 C4/4 E4/4 A4/2 G#4/2 REST/2" " ", bpm = 148, wave = "square", volume = 18, repeat = "forever"
def sfx_rot = synth.melody with notes = (list "E5/32"), bpm = 240, wave = "triangle", volume = 45
def sfx_lock = synth.melody with notes = (list "G3/32"), bpm = 240, wave = "triangle", volume = 60
def sfx_line = synth.melody with notes = (list "C5/16", "E5/16", "G5/16"), bpm = 200, wave = "triangle", volume = 65
def sfx_tet = synth.melody with notes = (list "C5/16", "E5/16", "G5/16", "C6/8"), bpm = 200, wave = "triangle", volume = 70
def sfx_over = synth.melody with notes = (list "G4/8", "E4/8", "C4/4"), bpm = 160, wave = "triangle", volume = 65

to spawn_blocks sp as list of block
    c = sp.coords
    -> (list 1, 3, 5, 7) -> block with col = c.(it), row = c.(it + 1), color = sp.color
end

to key_hit keys prev k as hit_state
    check contains keys k and not (contains prev k) -> "hit"
    -> "none"
end

to toggle_status s as game_status
    check s is "playing" -> "paused"
    -> "playing"
end

to toggle_audio a as audio_mode
    check a is "on" -> "muted"
    -> "on"
end

to valid_pos cand board as pos_status
    loop cand
        c = it.col
        r = it.row
        check c < 1 or c > 10 or r < -1 or r > 20 or any board where it.col is c and it.row is r -> "blocked"
    end
    -> "valid"
end

to ghost_blocks w as list of block
    cur = w.active
    loop range 1 22
        nxt = update cur with row = it.row + 1
        check valid_pos nxt w.board is "blocked" -> stop
        cur = nxt
    end
    -> cur
end

to clear_full_lines board as list of block
    cur = board
    loop range 1 20
        r = it
        check (count (cur where it.row is r)) is 10
            cur = update (cur where it.row is not r) where it.row < r with row = it.row + 1
        end
    end
    -> cur
end

to init_world audio as tetris_world
    s1 = random:pick piece_catalog
    s2 = random:pick piece_catalog
    -> tetris_world with
        active = spawn_blocks s1
        board = list as block
        spec = s1
        next_spec = s2
        cx = s1.cx
        cy = s1.cy
        audio = audio
    end
end

to read_action keys prev_keys move_cd tick as player_action
    check key_hit keys prev_keys "r" is "hit" -> "restart"
    check key_hit keys prev_keys "m" is "hit" -> "mute"
    check key_hit keys prev_keys "p" is "hit" -> "pause"
    check key_hit keys prev_keys "space" is "hit" -> "drop"
    check key_hit keys prev_keys "up" is "hit" or key_hit keys prev_keys "w" is "hit" -> "rotate"
    check move_cd is 0 and (contains keys "left" or contains keys "a") -> "left"
    check move_cd is 0 and (contains keys "right" or contains keys "d") -> "right"
    check (contains keys "down" or contains keys "s") and (tick % 2) is 0 -> "soft_drop"
    -> "none"
end

to tick_move_cd keys w as tetris_world
    held_lr = "no"
    check contains keys "left" or contains keys "a" or contains keys "right" or contains keys "d"
        held_lr = "yes"
    end
    check held_lr is "no" -> w with move_cd = 0
    check w.move_cd > 0 -> w with move_cd = w.move_cd - 1
    -> w
end

to shift_piece w dx as tetris_world
    cand = update w.active with col = it.col + dx
    check valid_pos cand w.board is "blocked" -> w with move_cd = 7
    -> w with active = cand, cx = w.cx + dx, move_cd = 7
end

to rotate_piece w as tetris_world
    check w.spec.kind is "O" -> w
    rot = update w.active with
        col = w.cx - (it.row - w.cy)
        row = w.cy + (it.col - w.cx)
    end
    kx = list 0, -1, 1, -2, 2, 0
    ky = list 0, 0, 0, 0, 0, -1
    loop range 1 6
        dx_k = kx.(it)
        dy_k = ky.(it)
        cand = update rot with col = it.col + dx_k, row = it.row + dy_k
        check valid_pos cand w.board is "valid"
            -> w with
                active = cand
                cx = w.cx + dx_k
                cy = w.cy + dy_k
                last_event = "rotated"
            end
        end
    end
    -> w
end

to lock_and_spawn w piece bonus as tetris_world
    merged = append w.board piece
    after = clear_full_lines merged
    cleared = floor (((count merged) - (count after)) / 10)
    nl = w.lines + cleared
    pts = bonus + ((list 0, 100, 300, 500, 800).(cleared + 1) * w.level)
    evt = (list "locked", "line", "line", "line", "tetris").(cleared + 1) as sound_event
    nxt = spawn_blocks w.next_spec
    lvl = 1 + (floor (nl / 10))
    check valid_pos nxt after is "blocked"
        -> w with
            active = nxt
            board = after
            score = w.score + pts
            lines = nl
            level = lvl
            status = "over"
            last_event = "over"
        end
    end
    -> w with
        active = nxt
        board = after
        spec = w.next_spec
        next_spec = random:pick piece_catalog
        cx = w.next_spec.cx
        cy = w.next_spec.cy
        score = w.score + pts
        lines = nl
        level = lvl
        grav_cd = 0
        last_event = evt
    end
end

to hard_drop w as tetris_world
    dropped = ghost_blocks w
    bonus = (dropped.1.row - w.active.1.row) * 2
    -> lock_and_spawn w dropped bonus
end

to step_fall w soft_pts as tetris_world
    nxt = update w.active with row = it.row + 1
    check valid_pos nxt w.board is "valid"
        -> w with
            active = nxt
            cy = w.cy + 1
            score = w.score + soft_pts
            grav_cd = 0
        end
    end
    -> lock_and_spawn w w.active 0
end

to handle_action w action as tetris_world
    check action is "restart" -> init_world w.audio
    check action is "mute" -> w with audio = toggle_audio w.audio
    check action is "pause" and w.status is not "over" -> w with status = toggle_status w.status
    check w.status is not "playing" -> w
    check action is "left" -> shift_piece w -1
    check action is "right" -> shift_piece w 1
    check action is "rotate" -> rotate_piece w
    check action is "soft_drop" -> step_fall w 1
    check action is "drop" -> hard_drop w
    -> w
end

to step_gravity w as tetris_world
    check w.status is not "playing" or w.last_event is "locked" or w.last_event is "line" or w.last_event is "tetris" -> w
    check (w.grav_cd + 1) < (max 6 (48 - ((w.level - 1) * 4))) -> w with grav_cd = w.grav_cd + 1
    -> step_fall w 0
end

to event_sfx ev as synth.melody
    check ev is "rotated" -> sfx_rot
    check ev is "locked" -> sfx_lock
    check ev is "line" -> sfx_line
    check ev is "tetris" -> sfx_tet
    -> sfx_over
end

to sync_audio prev_w w
    check w.status is not prev_w.status or w.audio is not prev_w.audio
        check w.status is "playing" and w.audio is "on"
            synth:play korobeiniki_bgm
        else
            synth:stop
        end
    end
    check w.audio is not "on" or w.last_event is "none" -> return
    spawn synth:play (event_sfx w.last_event)
end

to cell_box b inset as screen.box
    -> screen.box with
        x = 24 + ((b.col - 1) * 28) + inset
        y = 52 + ((b.row - 1) * 28) + inset
        width = 28 - (inset * 2)
        height = 28 - (inset * 2)
        color = b.color
    end
end

to draw_game win w
    screen:clear win "#0f172a"
    screen:draw win (list as screen.box with
        x = 24, y = 52, width = 280, height = 560, color = "#020617"
        x = 332, y = 52, width = 164, height = 132, color = "#1e293b"
        x = 332, y = 52, width = 164, height = 132, color = "#334155", style = "outline", stroke = 2
        x = 332, y = 200, width = 164, height = 176, color = "#1e293b"
        x = 332, y = 200, width = 164, height = 176, color = "#334155", style = "outline", stroke = 2
        x = 22, y = 50, width = 284, height = 564, color = "#334155", style = "outline", stroke = 2
    end)
    screen:draw win ((range 1 19) -> screen.line with x1 = 24, y1 = 52 + (it * 28), x2 = 304, y2 = 52 + (it * 28), width = 1, color = "#1e293b")
    screen:draw win ((range 1 9) -> screen.line with x1 = 24 + (it * 28), y1 = 52, x2 = 24 + (it * 28), y2 = 612, width = 1, color = "#1e293b")
    check w.status is "playing"
        screen:draw win ((ghost_blocks w) where it.row >= 1 -> (cell_box it 2) with style = "outline", stroke = 2)
    end
    screen:draw win (w.board where it.row >= 1 -> cell_box it 1)
    screen:draw win (w.active where it.row >= 1 -> cell_box it 1)
    screen:draw win (spawn_blocks w.next_spec -> screen.box with
        x = 372 + ((it.col - 4) * 22)
        y = 98 + ((it.row - 1) * 22)
        width = 20
        height = 20
        color = it.color
    end)
    screen:draw win (list as screen.label with
        x = 24, y = 16, content = "EASE TETRIS   60 FPS", size = 22, color = "#06b6d4"
        x = 346, y = 64, content = "NEXT", size = 16, color = "#cbd5e1"
        x = 346, y = 218, content = "SCORE  {w.score}", size = 18, color = "#facc15"
        x = 346, y = 264, content = "LVL {w.level}   LINES {w.lines}", size = 16, color = "#10b981"
        x = 332, y = 404, content = "Move: L/R   Rot: Up/W", size = 13, color = "#94a3b8"
        x = 332, y = 428, content = "Drop: Dn/Space   Pause: P", size = 13, color = "#94a3b8"
        x = 332, y = 452, content = "Audio({w.audio}): M  Reset: R  Esc", size = 13, color = "#94a3b8"
    end)
    check w.status is not "playing"
        clr = "#eab308"
        msg = "PAUSED - Press P"
        check w.status is "over"
            clr = "#ef4444"
            msg = "GAME OVER - Press R"
        end
        screen:draw win (screen.box with x = 36, y = 260, width = 256, height = 84, color = "#020617")
        screen:draw win (screen.box with x = 36, y = 260, width = 256, height = 84, color = clr, style = "outline", stroke = 3)
        screen:draw win (screen.label with x = 56, y = 290, content = msg, size = 18, color = clr)
    end
end

to run_tetris
    win = screen.screen with width = 520, height = 660, title = "Ease Tetris", fps = 60
    w = init_world ("on" as audio_mode)
    prev_keys = list as text
    synth:play korobeiniki_bgm
    loop
        draw_game win w
        frame = screen:show win
        check frame.status is "closed" or contains frame.keys "escape" -> stop
        keys = frame.keys
        prev_w = w
        w = tick_move_cd keys (w with last_event = "none")
        action = read_action keys prev_keys w.move_cd it.index
        w = handle_action w action
        w = step_gravity w
        sync_audio prev_w w
        prev_keys = keys
    end
    synth:stop
end

test "tetris pure intent/action: rotation wall-kick and multi-line clear"
    t = piece_catalog.3
    w0 = tetris_world with
        active = (update (spawn_blocks t) with col = it.col - 3, row = it.row + 2)
        board = list as block
        spec = t
        next_spec = t
        cx = 2
        cy = 4
    end
    w1 = handle_action w0 "rotate"
    count w1.active is 4
    w1.cx >= 2
    w1.last_event is "rotated"
    b19 = (range 1 10) -> block with col = it, row = 19, color = "#06b6d4"
    b20 = (range 1 10) -> block with col = it, row = 20, color = "#eab308"
    board = append (append b19 b20) (block with col = 5, row = 18, color = "#a855f7")
    after = clear_full_lines board
    count after is 1
    after.1.col is 5
    after.1.row is 20
    count (ghost_blocks (w1 with board = after)) is 4
end

run_tetris
