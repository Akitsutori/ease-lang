def particle
    x = 0
    vx = 10
    life = 100
    state = "active" | "dead"
end

to next_particle_state next_life
    check next_life <= 0 -> "dead"
    -> "active"
end

to update_particles items dt
    -> update items where it.state is "active" with
        x     = it.x + it.vx * dt
        life  = max 0 (it.life - 10 * dt)
        state = next_particle_state (it.life - 10 * dt)
    end
end

test
    cloud = list as particle with
        x = 0, vx = 5, life = 20
        x = 10, vx = 2, life = 5
    end

    stepped = update_particles cloud 1

    count stepped is 2
    stepped.1.x is 5
    stepped.1.state is "active"
    stepped.2.x is 12
    stepped.2.life is 0
    stepped.2.state is "dead"
end
