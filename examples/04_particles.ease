def particle
    x = 0
    vx = 10
    life = 100
    state = "active" | "dead"
end

to step_particle p dt
    next_life = p.life - 10 * dt
    next_x = p.x + p.vx * dt
    check next_life <= 0 -> p with x = next_x, life = 0, state = "dead"
    -> p with x = next_x, life = next_life
end

to update_particles items dt
    out = list as particle
    loop items
        check it.state is "dead"
            out = append out it
        end
        check it.state is "active"
            out = append out step_particle it dt
        end
    end
    -> out
end

test
    cloud = list as particle with
        x = 0, vx = 5, life = 20
        x = 10, vx = 2, life = 5
    end

    stepped = update_particles cloud 1

    count stepped is 2
    stepped.1.x is 5
    stepped.1.state is "active"
    stepped.2.x is 12
    stepped.2.state is "dead"
end
