# README Syntax-Spezifikation: Happy Paths & Laufzeit-Negativtests (Review-Vorlage)
# Alle Parser-/Lexer-/Typecheck-Negativtests (ungültige Syntax wie fehlendes `end`,
# `as ö`, `as bool`, `let x = 1`, `[1, 2]`, `fn(1)`) stehen begleitend in:
#   examples/syntax_review.md

import network

# 1. Variablen, Konstanten & String-Interpolation
def pi = 3.14
counter = 10
counter = counter + 5
greeting = "Hallo \{Ease\}: {counter}"

# 2. Funktionen (ohne Kommas!) & `to ask`
to add a b
    a + b
end

to ask client path
    "{client.url}{path}"
end

# 3. Records (`def`), `with`-Kopien & Union-Types
def ticket = "vip" | "standard" | "none"

def player
    name  = "Guest"
    hp    = 100
    state = "idle" | "running" | "KO"
end

def api_user
    id   = 0
    name = "Gast"
    role = "guest" | "admin"
end

hero = player with name = "Aria", hp = 80
ko   = hero with hp = 0, state = "KO"

# 4. Guards (`check`) & Verzweigung (`if`)
to classify n
    check n is 0 -> "zero"
    if n > 0
        "positive"
    else
        "non-positive"
    end
end

to bad_if_cond x
    if x
        "ok"
    end
end

to bad_check_cond x
    check x -> "ok"
    "done"
end

# 5. Typ- & Logik-Hilfsfunktionen für Negativtests
to bad_not x
    not x
end

to bad_and a b
    a and b
end

to bad_or a b
    a or b
end

to bad_lt a b
    a < b
end

to bad_interp val
    "Wert: {val}"
end

# 6. Schleifen-Hilfsfunktionen für Negativtests
to bad_repeat n
    repeat n
        1
    end
end

to bad_for x
    for item in x
        item
    end
end

# ============================================================================
# HAPPY PATHS (1 pro README-Abschnitt)
# ============================================================================
test "Happy Paths gemäß README"
    pi is 3.14
    counter is 15
    greeting is "Hallo \{Ease\}: 15"

    do add 2 3 is 5
    client = network with url = "https://example.test"
    do ask client "/posts/1" is "https://example.test/posts/1"

    hero.hp is 80
    ko.state is "KO"
    "vip" is ticket

    do classify 5 is "positive"
    do classify 0 is "zero"
    do classify -2 is "non-positive"

    "42" as number is 42
    42 as text is "42"
    "vip" as ticket is "vip"
    (do decode_json '{"id": 7, "name": "Gast", "role": "admin"}') as api_user is api_user
    do decode_json '{"id": 7, "msg": "hi\n{raw}"}' is not text

    scores = list 10, 25, 40
    scores.0 is 10
    5 % 0.5 is 0
    empty_nums = list as number
    do len empty_nums is 0
    do range 1 3 is list 1, 2, 3
end

# ============================================================================
# NEGATIVTESTS (Laufzeit-Fehlerabbrüche via `raises`)
# ============================================================================
test "Funktionen & Aufrufe: 10 Negativtests"
    do add 1 raises "expects 2 argument"
    do add 1 2 3 raises "expects 2 argument"
    do unbekannt 1 raises "Unknown function"
    do missing_fn raises "Unknown function"
    do ask 123 "/x" raises "Cannot read field"
    cond_yes = 1 > 0
    cond_no = 1 < 0
    do add hero 1 raises "Cannot add"
    do add cond_yes 1 raises "Cannot add"
    do add cond_yes cond_no raises "Cannot add"
    one_list = list 1
    do add one_list 1 raises "Cannot add"
    do add 1 one_list raises "Cannot add"
end

test "Records, with & Unions: 10 Negativtests"
    (42 with x = 1) raises "Cannot use 'with'"
    ("hi" with x = 1) raises "Cannot use 'with'"
    ((1 > 0) with x = 1) raises "Cannot use 'with'"
    ((list 1) with x = 1) raises "Cannot use 'with'"
    (hero with mana = 50) raises "has no field"
    (hero with state = "flying") raises "Invalid value"
    (hero with state = 123) raises "Invalid value"
    (hero with hp = "high") raises "expected number"
    (hero with id = 1) raises "has no field"
    hero.mana raises "has no field"
end

test "Guards, Verzweigungen, Logik & Vergleiche: 10 Negativtests"
    do bad_if_cond 42 raises "must be a condition"
    do bad_if_cond "yes" raises "must be a condition"
    do bad_check_cond 42 raises "must be a condition"
    do bad_check_cond "yes" raises "must be a condition"
    do bad_not 42 raises "requires a condition"
    do bad_not "no" raises "requires a condition"
    cond_yes = 1 > 0
    cond_no = 1 < 0
    do bad_and 1 cond_yes raises "requires condition"
    do bad_or cond_no 1 raises "requires condition"
    do bad_lt "a" 1 raises "requires numbers"
    do bad_lt cond_yes cond_no raises "requires numbers"
end

test "Striktes as Casting & decode_json (Ausgang B): 10 Negativtests"
    "abc" as number raises "Cannot convert text"
    "" as number raises "Cannot convert text"
    (list "a", "b") as number raises "Cannot convert"
    "pending" as ticket raises "not valid for union"
    123 as ticket raises "not valid for union"
    '{"id": 7, "name": "Gast", "role": "admin"}' as api_user raises "Cannot validate text"
    do decode_json "" raises "empty text"
    do decode_json '{broken' raises "Invalid JSON"
    (do decode_json 'null') as api_user raises "Cannot validate none"
    (do decode_json '{"id": 7, "role": "admin"}') as api_user raises "Missing field 'api_user.name'"
    (do decode_json '{"id": "abc", "name": "Gast", "role": "admin"}') as api_user raises "api_user.id"
    (do decode_json '{"id": 7, "name": "Gast", "role": "root"}') as api_user raises "api_user.role"
    hero as text raises "Cannot convert player to text"
    do bad_interp hero raises "Cannot interpolate player into text"
end

test "Listen, Schleifen & Built-ins: 10 Negativtests"
    xs = list 10, 20
    typed = list as number
    xs.99 raises "out of range"
    (42).0 raises "Cannot index"
    (list 10, "hi") raises "Mixed types"
    do push typed "bad" raises "Cannot push"
    do bad_repeat -1 raises "non-negative integer"
    do bad_repeat 1.5 raises "non-negative integer"
    do bad_repeat "3" raises "non-negative integer"
    do bad_for 42 raises "requires a list"
    10 / 0 raises "Division by zero"
    5 % 0 raises "Modulo by zero"
    do num "abc" raises "Cannot convert"
end
