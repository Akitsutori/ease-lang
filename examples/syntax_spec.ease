# README Syntax-Spezifikation: Happy Paths & Laufzeit-Negativtests (Review-Vorlage)
# Alle Parser-/Lexer-/Typecheck-Negativtests (ungültige Syntax wie fehlendes `end`,
# `as ö`, `as bool`, `let x = 1`, `[1, 2]`, `fn(1)`) stehen begleitend in:
#   examples/syntax_review.md

import network

# 1. Variablen, Konstanten & String-Interpolation
def pi = 3.14
counter = 10
counter = counter + 5
greeting = "Hallo \{Ease\}: {counter}"

# 2. Funktionen (ohne Kommas!) & Einzeiler
to add a b -> a + b

to mock_fetch client path -> "{client.url}{path}"

# 3. Records (`def`), `with`-Kopien & Union-Types
def ticket = "vip" | "standard" | "none"

def player
    name  = "Guest"
    hp    = 100
    state = "idle" | "running" | "KO"
end

def api_user
    id   = 0
    name = "Gast"
    role = "guest" | "admin"
end

hero = player with name = "Aria", hp = 80
ko   = hero with hp = 0, state = "KO"

# 4. Guards & Verzweigung (`check` / `else`)
to classify n
    check n is 0 -> "zero"
    check n > 0  -> "positive"
    -> "non-positive"
end

to bad_check_cond x
    check x -> "ok"
    -> "done"
end

# 5. Typ- & Logik-Hilfsfunktionen für Negativtests
to bad_not x
    check not x -> "ok"
    -> "done"
end

to bad_and a b
    check a and b -> "ok"
    -> "done"
end

to bad_or a b
    check a or b -> "ok"
    -> "done"
end

to bad_lt a b
    check a < b -> "ok"
    -> "done"
end

to bad_interp val -> "Wert: {val}"

# 6. Schleifen-Hilfsfunktionen für Negativtests
to bad_loop x
    loop x
        it
    end
end

to bad_loop_range a b
    loop range a b
        it
    end
end

# ============================================================================
# HAPPY PATHS (1 pro README-Abschnitt)
# ============================================================================
test "Happy Paths gemäß README"
    pi is 3.14
    counter is 15
    greeting is "Hallo \{Ease\}: 15"

    add 2 3 is 5
    client = network.network with url = "https://example.test"
    mock_fetch client "/posts/1" is "https://example.test/posts/1"

    hero.hp is 80
    ko.state is "KO"
    "vip" is ticket

    classify 5 is "positive"
    classify 0 is "zero"
    classify -2 is "non-positive"

    "42" as number is 42
    42 as text is "42"
    "vip" as ticket is "vip"
    (decode_json '{"id": 7, "name": "Gast", "role": "admin"}') as api_user is api_user
    decode_json '{"id": 7, "msg": "hi\n{raw}"}' is not text

    scores = list 10, 25, 40
    scores.1 is 10
    5 % 0.5 is 0
    empty_nums = list as number
    count empty_nums is 0
    range 1 3 is list 1, 2, 3
end

# ============================================================================
# NEGATIVTESTS (Laufzeit-Fehlerabbrüche via `is error`)
# ============================================================================
test "Funktionen & Aufrufe: 10 Negativtests"
    ("abc" as number) is error
    count 42 is error
    (1 / 0) is error
    range 1 1000000000 is error
    mock_fetch 123 "/x" is error
    add hero 1 is error
    ((1 > 0) + 1) is error
    ((1 > 0) + (1 < 0)) is error
    ((list 1, 2) + (list 3, 4, 5)) is error
    ((list "a") + (list "b")) is error
end

test "Records, with & Unions: 10 Negativtests"
    (42 with x = 1) is error
    ("hi" with x = 1) is error
    ((1 > 0) with x = 1) is error
    ((list 1) with x = 1) is error
    (hero with mana = 50) is error
    (hero with state = "flying") is error
    (hero with state = 123) is error
    (hero with hp = "high") is error
    (hero with id = 1) is error
    hero.mana is error
end

test "Guards, Verzweigungen, Logik & Vergleiche: 8 Negativtests"
    bad_check_cond 42 is error
    bad_check_cond "yes" is error
    bad_not 42 is error
    bad_not "no" is error
    (1 and (1 > 0)) is error
    ((1 < 0) or 1) is error
    bad_lt "a" 1 is error
    ((1 > 0) < (1 < 0)) is error
end

test "Striktes as Casting & decode_json (Ausgang B): 10 Negativtests"
    "abc" as number is error
    "" as number is error
    (list "a", "b") as number is error
    "pending" as ticket is error
    123 as ticket is error
    '{"id": 7, "name": "Gast", "role": "admin"}' as api_user is error
    decode_json "" is error
    decode_json '{broken' is error
    (decode_json 'null') as api_user is error
    (decode_json '{"id": 7, "role": "admin"}') as api_user is error
    (decode_json '{"id": "abc", "name": "Gast", "role": "admin"}') as api_user is error
    (decode_json '{"id": 7, "name": "Gast", "role": "root"}') as api_user is error
    hero as text is error
    bad_interp hero is error
end

test "Listen, Schleifen & Built-ins: 10 Negativtests"
    xs = list 10, 20
    typed = list as number
    xs.99 is error
    (42).1 is error
    (list 10, "hi") is error
    append typed "bad" is error
    bad_loop 42 is error
    bad_loop "3" is error
    bad_loop_range 1 "x" is error
    xs.(1.5) is error
    10 / 0 is error
    5 % 0 is error
    ("abc" as number) is error
end
