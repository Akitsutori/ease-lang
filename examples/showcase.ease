# Ease Language Showcase: Baupläne, Union Types, check-Guards & Listen

def role = "admin" | "member" | "guest"

def account
    name   = "Gast"
    role   = "guest"
    status = "active" | "inactive"
end

to greet user
    check
        user is not account       -> "Ungültiges Konto"
        user.role is not role     -> "Unbekannte Rolle"
        user.status is "inactive" -> "Konto deaktiviert"
        user.role is "admin"      -> "Admin-Zugang für {user.name}"
    end
    -> "Willkommen, {user.name}!"
end

to sum_squares nums
    total = 0
    loop nums
        total = total + (it * it)
    end
    -> total
end

test "Showcase Kernfeatures"
    ada = account with name = "Ada", role = "admin"
    bob = account with name = "Bob", role = "member", status = "inactive"

    greet ada is "Admin-Zugang für Ada"
    greet bob is "Konto deaktiviert"
    guest = account with status = "active"
    greet guest is "Willkommen, Gast!"

    xs = range 1 5
    count xs is 5
    sum_squares xs is 55
end

ada = account with name = "Ada", role = "admin"
say greet ada
say "Summe der Quadrate 1..5: {sum_squares range 1 5}"
