# Fibonacci in Ease: Rekursion, check-Guards & integrierte Unit-Tests

to fib n
    check
        n <= 0 -> 0
        n is 1 -> 1
    end
    left = fib (n - 1)
    right = fib (n - 2)
    left + right
end

test
    fib 0 is 0
    fib 1 is 1
    fib 5 is 5
    fib 10 is 55
end

say "fib(10) = {fib 10}"
