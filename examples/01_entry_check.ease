# ==============================================================================
# Eintrittskontrolle: to...end, check-Guards, Typprüfung (is / is not),
# test-Blöcke, ask und String-Interpolation
# ==============================================================================

to allow_entry name age
    check name is not text  -> "Name muss Text sein"
    check name is ""        -> "Name darf nicht leer sein"
    check age is not number -> "Alter muss eine Zahl sein"
    check age < 18          -> "Du bist {age}. Das ist jung"
    check age > 120         -> "Ungültiges Alter"

    -> "Willkommen {name}, du darfst rein!"
end

to validate_vip code age
    check code is not text      -> "invalid"
    check code is not "VIP2026" -> "invalid"
    check age is not number     -> "invalid"
    check age < 18              -> "invalid"
    -> "valid"
end

test "Einlassregeln & VIP-Prüfung"
    allow_entry 123 25      is "Name muss Text sein"
    allow_entry "" 25       is "Name darf nicht leer sein"
    allow_entry "Max" "abc" is "Alter muss eine Zahl sein"
    allow_entry "Max" 16    is "Du bist 16. Das ist jung"
    allow_entry "Max" 150   is "Ungültiges Alter"
    allow_entry "Max" 25    is "Willkommen Max, du darfst rein!"

    validate_vip "VIP2026" 20  is "valid"
    validate_vip "VIP2026" 16  is "invalid"
    validate_vip "FALSCH" 25   is "invalid"
    validate_vip "VIP2026" "x" is "invalid"
end

# Interaktiver Hauptablauf mit Tastatureingabe (ask)
say "--- Einlasskontrolle ---"
user_name = ask "Wie heißt du?"
raw_age   = ask "Wie alt bist du?"
check raw_age is ""
    say (allow_entry user_name raw_age)
else
    user_age = raw_age as number
    result = allow_entry user_name user_age
    say result
end
