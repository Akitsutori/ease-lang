import screen

to move_x x key
    check key is "right" -> x + 6
    check key is "left"  -> x - 6
    -> x
end

to clamp_x x min_x max_x
    check x < min_x -> min_x
    check x > max_x -> max_x
    -> x
end

to run_window
    win = screen.screen with
        width  = 800
        height = 600
        title  = "Go with ease"
    end

    pos_x = 400
    state = screen.frame_state

    loop range 1 3600
        check state.status is "closed" -> "Fenster geschlossen"

        moved = move_x pos_x state.key
        pos_x = clamp_x moved 30 770

        current = screen.scene with
            background = "slate"
            circles = list as screen.circle with
                x = pos_x, y = 300, size = 35, color = "amber"
            end
            boxes = list as screen.box with
                x = 120, y = 500, width = 560, height = 24, color = "emerald"
            end
        end

        raw_state = screen:present win current
        parsed_state = raw_state as json
        state = parsed_state as screen.frame_state
        check state is not screen.frame_state -> "Fensterfehler"
    end

    -> "Fertig"
end

test
    move_x 100 "right" is 106
    move_x 100 "left"  is 94
    move_x 100 ""      is 100

    clamp_x 10 30 770  is 30
    clamp_x 900 30 770 is 770
    clamp_x 400 30 770 is 400
end

result = run_window
say "Status: {result}"