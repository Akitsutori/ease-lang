# Finale Approval-Testdatei: 05_network.ease
# Deckt import network, fetch (GET), send (POST) sowie die strikte
# Trennung zwischen Typ-Konformität (as) und Inhaltsvalidität (to + check) ab.

import network

def api_user
    id   = 0
    name = "Gast"
    role = "member" | "admin"
end

def event
    kind = "click" | "key" | "unknown"
    x    = 0
    y    = 0
    key  = ""
end

# 1. Stufe: Striktes Typ-Casting an der Grenze (Form via 'as' ohne stillen Fallback)
to parse_age raw
    raw as number
end

# 2. Stufe: Inhaltsvalidität in der Fachlogik (Bedeutung via 'to' + 'check')
to validate_age age
    check
        age is not number -> "Ungültiges Zahlenformat"
        age < 0           -> "Alter kann nicht negativ sein"
        age > 130         -> "Alter ist unrealistisch"
    end
    age
end

to describe_event ev
    check
        ev.kind is "click" -> "click@{ev.x},{ev.y}"
        ev.kind is "key"   -> "key:{ev.key}"
    end
    "unknown"
end

test "import network, ask/send Schnittstelle & Form vs. Inhalt"
    api = network with
        url     = "http://127.0.0.1:1"
        timeout = 1
        token   = "demo-token"
    end

    api is network
    api.timeout is 1
    api.token is "demo-token"

    # Offline / nicht erreichbare Gegenstelle liefert ehrlich ""
    raw_get  = fetch api "/age"
    raw_post = send api "/age" 42
    raw_get is ""
    raw_post is ""

    # Typ-Konformität (Form) vs. Inhaltsvalidität (Fachlogik)
    parse_age "25" is 25
    parse_age "-5" is -5
    parse_age "abc" is error

    validate_age parse_age "-5" is "Alter kann nicht negativ sein"
    validate_age parse_age "200" is "Alter ist unrealistisch"
    validate_age parse_age "25" is 25

    events = list as event with
        kind = "click", x = 120, y = 240
        kind = "key", key = "Enter"
        kind = "unknown"
    end
    count events is 3
    describe_event events.0 is "click@120,240"
    describe_event events.1 is "key:Enter"

    # Expliziter zweistufiger Weg: JSON-Parsing -> strikte Strukturprüfung (Pflichtfelder)
    raw_map = decode_json '{"id": 42, "name": "Gast", "role": "admin", "ignored": 1}'
    u = raw_map as api_user
    u is api_user
    u.id is 42
    u.name is "Gast"
    u.role is "admin"

    raw_json = encode_json u
    roundtrip = (decode_json raw_json) as api_user
    roundtrip is api_user

    '{"id": 42, "name": "Gast", "role": "admin"}' as api_user is error
    (decode_json '{"id": 42, "role": "admin"}') as api_user is error
    (decode_json '{"id": 42, "name": "Gast", "role": "hacker"}') as api_user is error
    decode_json "" is error
end
