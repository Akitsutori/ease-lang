# std/network.ease

def network
    url     = ""
    timeout = 5
    token   = ""
end

def http_request
    id      = ""
    method  = "GET" | "POST" | "PUT" | "DELETE"
    url     = ""
    path    = ""
    body    = ""
    remote  = ""
    token   = ""
    timeout = 5
end

def http_response
    status = 0
    body   = ""
    error  = ""
end

def tcp_client
    id     = ""
    remote = ""
    lines  = inbox as text
end

to fetch target path
    req = http_request with
        method  = "GET"
        url     = "{target.url}{path}"
        token   = target.token
        timeout = target.timeout
    end

    res = http_call req
    check res.error is not "" -> ""
    check res.status >= 400   -> ""
    -> res.body
end

to serialize_payload payload
    check payload is text   -> payload
    check payload is number -> payload as text
    -> payload as json
end

to send target path payload
    req = http_request with
        method  = "POST"
        url     = "{target.url}{path}"
        body    = serialize_payload payload
        token   = target.token
        timeout = target.timeout
    end

    res = http_call req
    check res.error is not "" -> ""
    check res.status >= 400   -> ""
    -> res.body
end

to serve_http port requests
    -> net_serve_http port requests
end

to reply_text req status body
    net_reply_text req status body
end

to reply_json req status data
    net_reply_json req status data
end

to serve_tcp port clients
    -> net_serve_tcp port clients
end

to tcp_send client msg
    net_send client msg
end
