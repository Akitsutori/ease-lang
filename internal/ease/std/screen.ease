# std/screen.ease

def fps_mode = number | "unlimited"

def screen
    width  = 800
    height = 600
    title  = "Ease Window"
    fps    = fps_mode
end

def event_kind = "close" | "key" | "click" | "move"

def event
    kind = event_kind
    key  = ""
    x    = 0
    y    = 0
end

def circle
    x      = 0
    y      = 0
    size   = 20
    color  = "red"
    style  = "solid" | "outline"
    stroke = 2
end

def box
    x      = 0
    y      = 0
    width  = 40
    height = 40
    color  = "blue"
    style  = "solid" | "outline"
    stroke = 2
end

def line
    x1    = 0
    y1    = 0
    x2    = 100
    y2    = 100
    width = 2
    color = "#ffffff"
end

def triangle
    x1     = 0
    y1     = 0
    x2     = 50
    y2     = 100
    x3     = 100
    y3     = 0
    color  = "#ffffff"
    style  = "solid" | "outline"
    stroke = 2
end

def label
    x       = 0
    y       = 0
    content = ""
    size    = 16
    color   = "#ffffff"
end

def shape = circle | box | line | triangle | label

def scene
    background = "black"
    circles    = list as circle
    boxes      = list as box
    lines      = list as line
    triangles  = list as triangle
    labels     = list as label
    shapes     = list as shape
end

def frame_state
    status  = "open" | "closed"
    key     = ""
    keys    = list as text
    mouse_x = 0
    mouse_y = 0
end

# Opens the window session bound to a user-owned `events = inbox as screen.event`.
# Closing `events` from Ease closes the window cleanly on the next tick.
to open target events
    screen_open target events
end

# Presents a scene to the window, renders 1 frame,
# and returns the current frame_state serialized as JSON text.
to present target current_scene -> screen_present target current_scene
