# std/screen.ease

def screen
    width  = 800
    height = 600
    title  = "Ease Window"
end

def circle
    x     = 0
    y     = 0
    size  = 20
    color = "red"
end

def box
    x      = 0
    y      = 0
    width  = 40
    height = 40
    color  = "blue"
end

def scene
    background = "black"
    circles    = list as circle
    boxes      = list as box
end

def frame_state
    status  = "open" | "closed"
    key     = ""
    mouse_x = 0
    mouse_y = 0
end

# Presents a scene to the window, renders 1 frame (60 FPS),
# and returns the current frame_state serialized as JSON text.
to present target current_scene
    screen_present target current_scene
end
